#!/usr/bin/env bash

while true; do
echo -e "\n----DISCO ping----"
    for _ in {1..3}; do
        tailscale ping --c 1 --until-direct=false "$1"
    done
echo -e "\n----TSMP ping----"
    for _ in {1..3}; do
        tailscale ping --c 1 --until-direct=false --tsmp "$1"
        sleep 1
    done
echo -e "\n----ICMP ping----"
    for _ in {1..3}; do
        tailscale ping --c 1 --until-direct=false --icmp "$1"
        sleep 1
    done
done
